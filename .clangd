# clangd config for the C++/CUDA sources under csrc/.
#
# Include paths come from compile_commands.json (CMAKE_EXPORT_COMPILE_COMMANDS,
# symlinked at the repo root). .cu files parse in clangd's native CUDA mode, so
# kernel-launch syntax (<<<...>>>) and builtins (threadIdx, ...) resolve. We only
# strip nvcc-only flags clang can't parse and point clangd at the CUDA toolkit.
#
# Kernels stay torch-free (raw pointers), so CUDA-mode parsing is clean; the torch
# glue lives in .cpp files, which parse as ordinary C++ where libtorch resolves.
CompileFlags:
  CompilationDatabase: .
  Add:
    - --cuda-path=/usr/local/cuda-13.0
    - --no-cuda-version-check
  Remove:
    - -forward-unknown-to-host-compiler
    - -gencode*
    - arch=*
    - --generate-code*
    - -Xcudafe*
    - --diag_suppress*
    - -Xcompiler*
    - -Xfatbin*
    - --expt-relaxed-constexpr
    - --expt-extended-lambda
    - --options-file
    - -ccbin*
    - --threads*
    - -rdc=*
    - -x
